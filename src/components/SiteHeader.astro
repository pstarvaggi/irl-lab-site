---
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Independent Reinforcement Learning Lab home">
    <span class="brand-mark"><strong>IRL</strong><em>LAB</em></span>
    <span class="brand-long">Independent Reinforcement Learning Lab</span>
  </a>
  <nav aria-label="Primary navigation">
    <a
      href="/experiments/"
      aria-current={pathname.startsWith("/experiments/") || pathname.startsWith("/notes/") ? "page" : undefined}
    >Experiments</a>
    <a href="/methods/" aria-current={pathname.startsWith("/methods/") ? "page" : undefined}>Methods</a>
    <a href="/about/" aria-current={pathname.startsWith("/about/") ? "page" : undefined}>About</a>
    <a href="https://github.com/pstarvaggi/independent-rl-lab">GitHub</a>
  </nav>
</header>
