---
import katex from "katex";
import "katex/dist/katex.min.css";

interface Props {
  tex: string;
  display?: boolean;
  label?: string;
}

const { tex, display = false, label } = Astro.props;
const html = katex.renderToString(tex, {
  displayMode: display,
  output: "htmlAndMathml",
  throwOnError: true,
  strict: "warn",
});
---

{display ? (
  <div class="math-display" aria-label={label} set:html={html} />
) : (
  <>
    {" "}<span class="math-inline" aria-label={label} set:html={html} />
  </>
)}
