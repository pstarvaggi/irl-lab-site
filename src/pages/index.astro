---
import { experimentIndex, timingOfBadLuck } from "../data/experiments";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Independent Reinforcement Learning Lab";
const description =
  "Reinforcement-learning experiments and research notes by Patrick Starvaggi, with exact model references where possible.";
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <section class="home-hero">
    <h1>Independent <em>RL Lab.</em></h1>
    <div class="hero-deck">
      <p>
        Experiments in sequential decision making under uncertainty. I build controlled
        environments, solve what I can exactly, and test where learned behavior changes.
      </p>
      <dl class="quiet-status" aria-label="Current experiment status">
        <div><dt>Current study</dt><dd>{timingOfBadLuck.kind} {timingOfBadLuck.number}</dd></div>
        <div><dt>Status</dt><dd>{timingOfBadLuck.statusDetail}</dd></div>
      </dl>
    </div>
  </section>

  <section class="featured-study" aria-labelledby="featured-title">
    <div class="feature-copy">
      <p class="section-number">{timingOfBadLuck.kind} {timingOfBadLuck.number}</p>
      <h2 id="featured-title">{timingOfBadLuck.title}</h2>
      <p class="feature-subtitle">{timingOfBadLuck.subtitle}</p>
      <p class="feature-lede">{timingOfBadLuck.description}</p>
      <p class="method-line">{timingOfBadLuck.methods.join(" · ")}</p>
      <a class="text-link" href={timingOfBadLuck.slug}>
        Read the note <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="feature-visual">
      <img
        src={timingOfBadLuck.results.figure}
        alt="Six plots showing how the probability of ending with the safe action changes with the timing of one adverse outcome, route depth, and step-size rule."
      />
      <p class="figure-note">
        Exact depth-one reference · 20,000 paired seeds per point · 26-second analysis
      </p>
    </div>
  </section>

  <section class="working-method" aria-labelledby="method-title">
    <header>
      <p class="section-number">METHODS</p>
      <h2 id="method-title">Methods used here.</h2>
    </header>
    <ol>
      <li><span>01</span><div><strong>Exact references.</strong><p>When the transition model is known, I calculate a dynamic-programming reference before training.</p></div></li>
      <li><span>02</span><div><strong>Matched comparisons.</strong><p>Methods use the same interaction budgets, seed panels, and held-out evaluation conditions.</p></div></li>
      <li><span>03</span><div><strong>Pilot and full-run roles.</strong><p>Pilot runs calibrate the protocol. Only the declared full runs support reported results.</p></div></li>
      <li><span>04</span><div><strong>Exceptions and failures.</strong><p>Instability, unresolved actions, failed trials, and results that complicate the summary remain visible.</p></div></li>
    </ol>
    <a class="text-link" href="/methods/">Read the methods <span aria-hidden="true">→</span></a>
  </section>

  <section class="research-ledger" aria-labelledby="ledger-title">
    <header>
      <p class="section-number">STUDIES</p>
      <h2 id="ledger-title">Study log.</h2>
    </header>
    {experimentIndex.map((experiment) => (
      <a class="ledger-row" href={experiment.slug}>
        <span>{experiment.kind} {experiment.number}</span>
        <strong>{experiment.title}</strong>
        <span>{experiment.date}</span>
        <span class="pending">{experiment.status}</span>
        <span aria-hidden="true">→</span>
      </a>
    ))}
  </section>
</BaseLayout>
