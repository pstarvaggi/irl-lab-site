---
import { experimentIndex } from "../../data/experiments";
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Experiments | Independent Reinforcement Learning Lab";
const description = "A chronological record of Independent RL Lab experiments.";
---

<BaseLayout title={title} description={description} canonicalPath="/experiments/">
  <header class="index-hero">
    <p class="kicker">Independent RL Lab</p>
    <h1>Experiments</h1>
    <p>A chronological record of the experiments, including their questions, methods, status, and reproducibility materials.</p>
  </header>
  <section class="experiment-index" aria-label="Experiment index">
    {experimentIndex.map((experiment) => (
      <article class="experiment-entry">
        <div class="experiment-entry-meta">
          <span>{experiment.number}</span>
          <span>{experiment.date}</span>
          <span>{experiment.status}</span>
        </div>
        <div>
          <h2><a href={experiment.slug}>{experiment.title}</a></h2>
          <p class="feature-subtitle">{experiment.subtitle}</p>
          <p>{experiment.description}</p>
          <p class="method-line">{experiment.methods.join(" · ")}</p>
        </div>
        <a class="entry-arrow" href={experiment.slug} aria-label={`Read ${experiment.title}`}>→</a>
      </article>
    ))}
  </section>
</BaseLayout>
